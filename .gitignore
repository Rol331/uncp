# Configuración local de Claude Code
.claude/

# Documentos internos / material de referencia (no publicar)
*.docx
*.pdf

# Fotos originales sin optimizar (~505 MB, incluye RAW .NEF/.CR2/.ARW).
# Las versiones listas para web viven en imagenes/ y esas SÍ se versionan.
img-carreras/

# Panel de administración: datos vivos y secretos, se crean EN EL SERVIDOR.
# El repo es público -> la contraseña y los datos nunca deben subirse.
/admin/config.php
/datos-admision.json
/documentos/*
!/documentos/.htaccess

# Sistema
.DS_Store
# candado que deja LibreOffice mientras tiene abierto un .docx
.~lock.*#
